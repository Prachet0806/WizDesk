# Local development. Replace this private key before running.
SECRET_KEY=replace-with-a-private-random-key-at-least-50-chars-before-running
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Leave unset for local SQLite. For hosted use, configure in Render:
# DATABASE_URL=<Neon pooled PostgreSQL URL; require TLS>
# MIGRATION_DATABASE_URL=<Neon direct PostgreSQL URL; require TLS>
WEB_CONCURRENCY=1
# Local email prints links to the development console. In Render set:
EMAIL_VERIFICATION_REQUIRED=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
FRONTEND_URL=http://localhost:8000
# RESEND_API_KEY=<private Resend API key>
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# EMAIL_VERIFICATION_REQUIRED=True
# DEFAULT_FROM_EMAIL=WizDesk <noreply@your-verified-domain.example>
# Render production settings:
# DEBUG=False
# ALLOWED_HOSTS=<service>.onrender.com
# CSRF_TRUSTED_ORIGINS=https://<service>.onrender.com
# FRONTEND_URL=https://<service>.onrender.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# WEB_CONCURRENCY=1
# LOG_LEVEL=INFO
