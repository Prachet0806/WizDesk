# .env.example — Django / Wizdesk Backend

# Django
SECRET_KEY=your-django-secret-key-at-least-50-chars
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database — uses DATABASE_URL (dj-database-url)
# Local SQLite (default if DATABASE_URL is not set):
# DATABASE_URL=sqlite:///db.sqlite3
# Aiven PostgreSQL example:
DATABASE_URL=postgres://avnadmin:PASSWORD@wizdeskdb-wizdeskdb.d.aivencloud.com:22095/defaultdb?sslmode=require
# AWS RDS example:
# DATABASE_URL=postgres://wizdesk_admin:PASSWORD@wizdesk-db.xxxx.us-east-1.rds.amazonaws.com:5432/wizdesk_db?sslmode=require

# Email (Django SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=wizdeskofficial@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True