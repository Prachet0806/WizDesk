# Required: generate a private random key with at least 50 characters.
SECRET_KEY=replace-with-a-private-random-key-before-running
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Unset DATABASE_URL for local SQLite. Example PostgreSQL connection:
# DATABASE_URL=postgresql://wizdesk_user:YOUR_PASSWORD@localhost:5433/wizdesk
# Required by Docker Compose only (choose a private development password):
# POSTGRES_PASSWORD=replace-with-your-private-development-password
# Set CACHE_URL and install requirements for shared throttling with multiple workers.
# CACHE_URL=redis://localhost:6379/1
WEB_CONCURRENCY=1
EMAIL_VERIFICATION_REQUIRED=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
FRONTEND_URL=http://localhost:8000
# To enable verification: configure SMTP, FRONTEND_URL, and change EMAIL_BACKEND.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-account
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@your-domain.example
EMAIL_TIMEOUT=10
